{
  "name": "tuk-tuk-api",
  "version": "1.0.0",
  "description": "REST API for real-time tuk-tuk tracking and movement logging",
  "type": "module",
  "main": "scripts/dbCheck.js",
  "scripts": {
    "db:check": "node scripts/dbCheck.js",
    "db:apply": "node scripts/dbApplySql.js",
    "db:tables": "node scripts/dbListTables.js",
    "db:device-keys": "node scripts/ensureDeviceApiKey.js",
    "db:set-password": "node scripts/setUserPassword.js",
    "db:migrate-station": "node scripts/migrateAddStationToTukTuks.js",
    "db:create-district-officer": "node scripts/createDistrictOfficerDemo.js",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.4.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "eslint": "^9.36.0"
  }
}