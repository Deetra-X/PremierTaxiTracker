PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require
JWT_SECRET=change_me_later
NODE_ENV=development

# JWT hardening
JWT_ISSUER=tuk-tuk-api
JWT_AUDIENCE=tuk-tuk-web
JWT_EXPIRES_IN=1h
JWT_ALG=HS256

# CORS (comma-separated). Leave empty for default-deny.
# Example: CORS_ORIGIN=https://your-frontend.com,https://admin.your-frontend.com
CORS_ORIGIN=

# Docs (Swagger/OpenAPI)
# In production, keep this false (or HQ_ADMIN-only access will apply if true)
ENABLE_API_DOCS=true

# Tracking privacy controls
LOCATION_PRECISION_DECIMALS=5
ENABLE_NIC_SEARCH=false
INCLUDE_DRIVER_NIC_IN_RESPONSE=false

